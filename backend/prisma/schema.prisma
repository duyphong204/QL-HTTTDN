// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  HR_MANAGER
  WAREHOUSE_MANAGER
  SALES_MANAGER
  EMPLOYEE
  CUSTOMER
}

enum PromotionType {
  PERCENT
  FIXED
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  password         String
  role             Role      @default(CUSTOMER)
  refreshTokenHash String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  isActive         Boolean   @default(true)
  deletedAt        DateTime?

  profile  Profile?
  employee Employee?
  orders   Order[]
  cart     Cart?
  logs     SystemLog[]
}

model Profile {
  id          String    @id @default(uuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id])
  fullName    String
  phone       String?
  address     String?
  avatar      String?
  dateOfBirth DateTime?
}

// --- HR MODULE ---

model Employee {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])
  code   String @unique // Mã nhân viên (ví dụ: NV001)

  department String? // Gộp trực tiếp: Kinh doanh, Kho, Nhân sự...
  position   String? // Gộp trực tiếp: Trưởng phòng, Nhân viên, Kế toán...

  baseSalary Float
  joinDate   DateTime  @default(now())
  resignDate DateTime?

  salaries      Salary[]
  leaveRequests LeaveRequest[]
  jobHistories  JobHistory[]
}

model JobHistory {
  id         String    @id @default(uuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id])
  department String?
  position   String?
  baseSalary Float
  startDate  DateTime  @default(now())
  endDate    DateTime?
}

model Salary {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  month      Int
  year       Int
  amount     Float
  bonus      Float    @default(0)
  deduction  Float    @default(0)
  status     String // PAID, PENDING
  createdAt  DateTime @default(now())
}

model LeaveRequest {
  id           String   @id @default(uuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id])
  startDate    DateTime
  endDate      DateTime
  type         String // SICK, ANNUAL, MATERNITY
  reason       String
  status       String   @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedById String?
  createdAt    DateTime @default(now())
}

// --- WAREHOUSE MODULE ---

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  products Product[]
}

model Supplier {
  id       String    @id @default(uuid())
  name     String
  address  String?
  phone    String?
  email    String?
  products Product[]
  stockIns StockIn[]
}

model Product {
  id            String  @id @default(uuid())
  name          String
  description   String?
  price         Float // Current selling price
  costPrice     Float // Current cost price
  stockQuantity Int     @default(0)
  minStock      Int     @default(10)

  imageUrl String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  stockInDetails StockInDetail[]
  orderDetails   OrderDetail[]
  cartItems      CartItem[]
  promotionLinks PromotionProduct[]
}

model Promotion {
  id        String        @id @default(uuid())
  name      String
  type      PromotionType
  value     Float
  startAt   DateTime?
  endAt     DateTime?
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  products PromotionProduct[]
}

model PromotionProduct {
  id          String    @id @default(uuid())
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id])
  productId   String    @unique
  product     Product   @relation(fields: [productId], references: [id])

  @@unique([promotionId, productId])
}

model StockIn {
  id          String   @id @default(uuid())
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id])
  date        DateTime @default(now())
  totalAmount Float
  createdById String?

  details StockInDetail[]
}

model StockInDetail {
  id        String  @id @default(uuid())
  stockInId String
  stockIn   StockIn @relation(fields: [stockInId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float // Historical cost price
}

// --- SALES & ECOMMERCE ---

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String  @id @default(uuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)
}

model Order {
  id            String   @id @default(uuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  fullName      String
  phone         String
  address       String
  totalAmount   Float
  status        String   @default("PENDING") // PENDING, APPROVED, SHIPPING, COMPLETED, CANCELLED
  paymentMethod String   @default("COD")
  paymentStatus String   @default("UNPAID")
  createdAt     DateTime @default(now())

  details             OrderDetail[]
  paymentTransactions PaymentTransaction[]
}

model PaymentTransaction {
  id            String    @id @default(uuid())
  orderId       String
  order         Order     @relation(fields: [orderId], references: [id])
  provider      String
  providerTxnId String?   @unique
  amount        Float
  status        String    @default("PENDING")
  rawPayload    Json?
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([orderId])
  @@index([status])
}

model OrderDetail {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float // Selling price at time of sale
  costPrice Float // Cost price at time of sale for profit calculation
}

model SystemLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  details   String?
  createdAt DateTime @default(now())
}

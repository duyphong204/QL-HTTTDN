generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String      @id @default(uuid())
  email            String      @unique
  password         String
  role             Role        @default(CUSTOMER)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  refreshTokenHash String?
  deletedAt        DateTime?
  isActive         Boolean     @default(true)
  cart             Cart?
  employee         Employee?
  orders           Order[]
  profile          Profile?
  logs             SystemLog[]
}

model Profile {
  id          String    @id @default(uuid())
  userId      String    @unique
  fullName    String
  phone       String?
  address     String?
  avatar      String?
  dateOfBirth DateTime?
  user        User      @relation(fields: [userId], references: [id])
}

model Employee {
  id            String         @id @default(uuid())
  userId        String         @unique
  code          String         @unique
  position      String?
  baseSalary    Float
  joinDate      DateTime       @default(now())
  resignDate    DateTime?
  department    String?
  user          User           @relation(fields: [userId], references: [id])
  jobHistories  JobHistory[]
  leaveRequests LeaveRequest[]
  salaries      Salary[]
}

model JobHistory {
  id         String    @id @default(uuid())
  employeeId String
  department String?
  position   String?
  baseSalary Float
  startDate  DateTime  @default(now())
  endDate    DateTime?
  employee   Employee  @relation(fields: [employeeId], references: [id])
}

model Salary {
  id         String   @id @default(uuid())
  employeeId String
  month      Int
  year       Int
  amount     Float
  status     String
  createdAt  DateTime @default(now())
  bonus      Float    @default(0)
  deduction  Float    @default(0)
  employee   Employee @relation(fields: [employeeId], references: [id])
}

model LeaveRequest {
  id           String   @id @default(uuid())
  employeeId   String
  startDate    DateTime
  endDate      DateTime
  type         String
  reason       String
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())
  approvedById String?
  employee     Employee @relation(fields: [employeeId], references: [id])
}

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  products Product[]
}

model Supplier {
  id       String    @id @default(uuid())
  name     String
  address  String?
  phone    String?
  email    String?
  products Product[]
  stockIns StockIn[]
}

model Product {
  id             String          @id @default(uuid())
  name           String
  description    String?
  price          Float
  costPrice      Float
  stockQuantity  Int             @default(0)
  categoryId     String
  supplierId     String
  minStock       Int             @default(10)
  imageUrl       String?
  deletedAt        DateTime?
  cartItems      CartItem[]
  orderDetails   OrderDetail[]
  category       Category        @relation(fields: [categoryId], references: [id])
  supplier       Supplier        @relation(fields: [supplierId], references: [id])
  stockInDetails StockInDetail[]
}

model StockIn {
  id          String          @id @default(uuid())
  supplierId  String
  date        DateTime        @default(now())
  totalAmount Float
  status      StockInStatus   @default(PENDING)
  createdById String?
  approvedById String?
  supplier    Supplier        @relation(fields: [supplierId], references: [id])
  details     StockInDetail[]
}

enum StockInStatus {
  PENDING    
  COMPLETED  
  CANCELLED  
}

model StockInDetail {
  id        String  @id @default(uuid())
  stockInId String
  productId String
  quantity  Int
  price     Float
  product   Product @relation(fields: [productId], references: [id])
  stockIn   StockIn @relation(fields: [stockInId], references: [id])
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]
}

model CartItem {
  id        String  @id @default(uuid())
  cartId    String
  productId String
  quantity  Int     @default(1)
  cart      Cart    @relation(fields: [cartId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

model Order {
  id            String        @id @default(uuid())
  userId        String?
  fullName      String
  phone         String
  address       String
  totalAmount   Float
  status        String        @default("PENDING")
  createdAt     DateTime      @default(now())
  paymentMethod String        @default("COD")
  paymentStatus String        @default("UNPAID")
  user          User?         @relation(fields: [userId], references: [id])
  details       OrderDetail[]
}

model OrderDetail {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  price     Float
  costPrice Float
  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

model SystemLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  details   String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

enum Role {
  ADMIN
  HR_MANAGER
  WAREHOUSE_MANAGER
  SALES_MANAGER
  EMPLOYEE
  CUSTOMER
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Cleaned single-schema: canonical models and enums

model User {
  id               String      @id @default(uuid())
  email            String      @unique
  password         String
  role             Role        @default(CUSTOMER)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  refreshTokenHash String?
  deletedAt        DateTime?
  isActive         Boolean     @default(true)
  cart             Cart?
  employee         Employee?
  orders           Order[]
  profile          Profile?
  logs             SystemLog[]
  createdStockIns  StockIn[]   @relation("StockInCreatedBy")
  approvedStockIns StockIn[]   @relation("StockInApprovedBy")
}

model Profile {
  id          String    @id @default(uuid())
  userId      String    @unique
  fullName    String
  phone       String?
  address     String?
  avatar      String?
  dateOfBirth DateTime?
  user        User      @relation(fields: [userId], references: [id])
}

model Employee {
  id            String         @id @default(uuid())
  userId        String         @unique
  code          String         @unique
  position      String?
  baseSalary    Float          @default(0)
  joinDate      DateTime       @default(now())
  resignDate    DateTime?
  department    String?
  user          User           @relation(fields: [userId], references: [id])
  jobHistories  JobHistory[]
  leaveRequests LeaveRequest[]
  salaries      Salary[]
  attendances   Attendance[]
}

model JobHistory {
  id         String    @id @default(uuid())
  employeeId String
  department String?
  position   String?
  baseSalary Float
  startDate  DateTime  @default(now())
  endDate    DateTime?
  employee   Employee  @relation(fields: [employeeId], references: [id])
}

model Salary {
  id         String @id @default(uuid())
  employeeId String
  month      Int
  year       Int

  baseSalary Float @default(0)

  workingDays    Int @default(26)
  actualWorkDays Int @default(0)

  grossSalary    Float @default(0)
  totalBonus     Float @default(0)
  totalDeduction Float @default(0)

  netSalary Float @default(0)

  status SalaryStatus @default(PENDING)
  note   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  employee Employee       @relation(fields: [employeeId], references: [id])
  details  SalaryDetail[]

  paidAt DateTime?

  @@unique([employeeId, month, year])
  @@index([month, year])
  @@index([employeeId])
}

model SalaryDetail {
  id          String     @id @default(uuid())
  salaryId    String
  type        DetailType
  amount      Float
  description String?
  salary      Salary     @relation(fields: [salaryId], references: [id], onDelete: Cascade)
}

model Attendance {
  id         String           @id @default(uuid())
  employeeId String
  date       DateTime
  checkIn    DateTime?
  checkOut   DateTime?
  status     AttendanceStatus @default(PRESENT)

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date])
}

enum DetailType {
  BONUS
  OT
  ALLOWANCE
  DEDUCTION
  INSURANCE
  TAX
}

enum SalaryStatus {
  PENDING
  APPROVED
  PAID
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
  LATE
}

model LeaveRequest {
  id              String   @id @default(uuid())
  employeeId      String
  startDate       DateTime
  endDate         DateTime
  type            LeaveType
  reason          String
  status          String   @default("PENDING")
  rejectionReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  approvedById    String?
  employee        Employee @relation(fields: [employeeId], references: [id])
}
enum LeaveType {
  ANNUAL
  UNPAID
  SICK
  MATERNITY
  RESIGNATION
}
model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  products Product[]
}

model Supplier {
  id       String    @id @default(uuid())
  name     String
  address  String?
  phone    String?
  email    String?
  products Product[]
  stockIns StockIn[]
}

model Product {
  id              String             @id @default(uuid())
  name            String
  description     String?
  price           Float
  costPrice       Float
  stockQuantity   Int                @default(0)
  categoryId      String
  supplierId      String
  minStock        Int                @default(10)
  imageUrl        String?
  deletedAt       DateTime?
  cartItems       CartItem[]
  orderDetails    OrderDetail[]
  promotionLinks  PromotionProduct[]
  category        Category           @relation(fields: [categoryId], references: [id])
  supplier        Supplier           @relation(fields: [supplierId], references: [id])
  stockInDetails  StockInDetail[]
  stockOutDetails StockOutDetail[]
}

model StockIn {
  id           String          @id @default(uuid())
  supplierId   String
  date         DateTime        @default(now())
  totalAmount  Float
  createdById  String?
  approvedById String?
  status       StockInStatus   @default(PENDING)
  supplier     Supplier        @relation(fields: [supplierId], references: [id])
  details      StockInDetail[]
  createdBy    User?           @relation("StockInCreatedBy", fields: [createdById], references: [id])
  approvedBy   User?           @relation("StockInApprovedBy", fields: [approvedById], references: [id])
}

model StockInDetail {
  id        String  @id @default(uuid())
  stockInId String
  productId String
  quantity  Int
  price     Float
  product   Product @relation(fields: [productId], references: [id])
  stockIn   StockIn @relation(fields: [stockInId], references: [id])
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]
}

model CartItem {
  id        String  @id @default(uuid())
  cartId    String
  productId String
  quantity  Int     @default(1)
  cart      Cart    @relation(fields: [cartId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

model Order {
  id            String        @id @default(uuid())
  userId        String?
  fullName      String
  phone         String
  address       String
  totalAmount   Float
  status        String        @default("PENDING")
  createdAt     DateTime      @default(now())
  paymentMethod String        @default("COD")
  paymentStatus String        @default("UNPAID")
  user          User?         @relation(fields: [userId], references: [id])
  details       OrderDetail[]
  stockOuts     StockOut[]
}

model StockOut {
  id           String           @id @default(uuid())
  orderId      String?
  type         StockOutType
  createdById  String
  approvedById String?
  totalAmount  Float
  status       StockOutStatus   @default(PENDING)
  createdAt    DateTime         @default(now())
  order        Order?           @relation(fields: [orderId], references: [id])
  details      StockOutDetail[]
}

model StockOutDetail {
  id         String   @id @default(uuid())
  stockOutId String
  productId  String
  quantity   Int
  price      Float
  costPrice  Float    @default(0)
  stockOut   StockOut @relation(fields: [stockOutId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])
}

model OrderDetail {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  price     Float
  costPrice Float
  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

model SystemLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  details   String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

enum StockInStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum StockOutStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum StockOutType {
  SALE
  INTERNAL
  TRANSFER
}

enum Role {
  ADMIN
  HR_MANAGER
  WAREHOUSE_MANAGER
  SALES_MANAGER
  EMPLOYEE
  CUSTOMER
}

enum PromotionType {
  PERCENT
  FIXED
}

model Promotion {
  id        String        @id @default(uuid())
  name      String
  type      PromotionType
  value     Float
  startAt   DateTime?
  endAt     DateTime?
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  products PromotionProduct[]
}

model PromotionProduct {
  id          String    @id @default(uuid())
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id])
  productId   String    @unique
  product     Product   @relation(fields: [productId], references: [id])

  @@unique([promotionId, productId])
}
